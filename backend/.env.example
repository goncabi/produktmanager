# Copy to .env and fill in. .env is never committed.

# Hosted database (Neon, Render): the full connection URL is enough.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local database: the individual values.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=produktmanager
DB_PORT=5432
PORT=5000
# false for a local PostgreSQL without SSL; leave unset for hosted databases
DB_SSL=false
